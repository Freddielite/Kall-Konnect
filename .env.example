# Where the Express backend (server/) is running.
# `npm run dev` rewrites these to the current LAN IP automatically
# (scripts/sync-lan-ip.mjs). Pin it with LAN_IP=<addr> npm run dev if it
# ever picks the wrong network interface.
#
# Vite inlines these at dev-server START, so if the LAN IP changes while
# the dev server is running, the value baked into the bundle goes stale.
# src/lib/api.ts guards against that: when the host here is a
# LAN/localhost address that disagrees with the host the page was actually
# loaded from, it uses the page's host instead (and warns in the console).
# Real domains are never rewritten, so production is unaffected.
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000

# ── Production on Vercel (split hosting via proxy) ──────────────────────
# Safari/Brave block SameSite=None cookies (third-party), which is what a
# direct Vercel → Render cross-origin setup requires — login would appear
# to succeed (200 response) but the cookie gets silently dropped, so the
# very next request 401s. See server/.env.example's COOKIE_SAMESITE notes.
#
# Fix: proxy /api/* (and therefore /api/ws) through vercel.json's rewrites
# to the Render backend, so requests look same-origin to the browser. Set
# these to RELATIVE paths (not full URLs) when deploying to Vercel:
#   VITE_API_URL=/api
#   VITE_WS_URL leave UNSET — it falls back to API_URL, and
#     src/lib/realtime.ts appends /ws itself, landing on /api/ws, which
#     vercel.json's /api/:path* rewrite already covers.
# Also set COOKIE_SAMESITE=lax in Render's env (see server/.env.example) —
# once traffic looks same-origin, None is unnecessary and Lax is safer.

# Set to true to disable the correction above and use VITE_API_URL exactly
# as written. Only needed when the frontend and backend genuinely run on
# different machines.
# VITE_API_URL_EXACT=true

# How long the frontend waits for a response before giving up, in ms.
# Optional — defaults to 15000.
# Don't go below ~6000: the backend's DB pool gives up at 5s and then
# returns a real error message. A tighter timeout here races the server and
# replaces that message with a generic "didn't respond" one.
# VITE_REQUEST_TIMEOUT_MS=15000

# Google Sign-In OAuth Client ID (type "Web application", from Google Cloud
# Console > APIs & Services > Credentials). Must match GOOGLE_CLIENT_ID in
# server/.env.
VITE_GOOGLE_CLIENT_ID=

# Sign in with Apple Services ID (e.g. com.wyntek.kallkonnect.web). Must
# match APPLE_CLIENT_ID in server/.env.
VITE_APPLE_CLIENT_ID=
