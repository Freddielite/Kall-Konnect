# Plain Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kall_konnect

# Where the frontend dev server runs (for CORS)
# Comma-separated list of frontend origins allowed to call this API.
# Defaults to both this project's actual dev port (8080, from
# vite.config.ts) and Vite's usual default (5173) so it works either way
# without editing this. Add your LAN IP here too if testing from another
# device, e.g.:
#   CORS_ORIGIN=http://localhost:8080,http://192.168.0.171:8080
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
# Where the frontend's /oauth/consent page lives (used by /oauth/authorize redirects)
APP_URL=http://localhost:5173

PORT=4000

# Any long random string — used to sign app JWTs and the short-lived
# pending-authorization tokens in the OAuth flow.
JWT_SECRET=change-me-to-a-long-random-string

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google Sign-In: create an OAuth Client ID (type "Web application") in
# Google Cloud Console > APIs & Services > Credentials. Add your frontend
# origin (e.g. http://localhost:5173) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Google Calendar (separate from Sign-In above — this is an additional,
# user-initiated OAuth grant that lets the app push real events into a
# user's calendar; Sign-In alone never authorizes that). In the SAME OAuth
# Client ID you created for GOOGLE_CLIENT_ID (Google Cloud Console > APIs &
# Services > Credentials), open it and:
#   1. Copy the "Client secret" shown there into GOOGLE_CLIENT_SECRET below.
#   2. Under "Authorized redirect URIs", add GOOGLE_CALENDAR_REDIRECT_URI's
#      value verbatim (this is the field Sign-In setup told you to leave
#      empty — that was for the token flow; this is the separate code flow,
#      which needs it).
# Must point at the BACKEND (this server), not the frontend.
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/google-calendar/callback

OAUTH_AUTH_CODE_TTL_SECONDS=300
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=90

# Shared secret for POST /jobs/generate-notifications, which lets an external
# scheduler run the daily reminder job.
#
# YOU ALMOST CERTAINLY NEED THIS IN PRODUCTION. The job is scheduled in-process
# with node-cron, which only fires if the process is awake at 06:00. Render's
# free tier spins down after ~15 minutes idle, so on that plan the daily
# reminder will essentially never be sent — which looks identical to "push
# notifications are broken" when push itself is fine.
#
# Generate with: openssl rand -hex 32
# Then see .github/workflows/daily-reminders.yml (already in this repo) or use
# cron-job.org. Leave blank locally; node-cron is enough when the process stays up.
CRON_SECRET=

# When the daily reminder runs. Server time is UTC on Render, so the default
# below reaches a Nigerian user (WAT, UTC+1) at 07:00 local. Set
# CRON_TIMEZONE=Africa/Lagos to make it 06:00 local instead. One global time
# for all users; per-user reminder_time is not supported yet.
CRON_SCHEDULE=0 6 * * *
CRON_TIMEZONE=

# Re-run the job ~10s after startup, in case a restart or redeploy straddled
# the scheduled minute and the daily tick was missed. Idempotent - does
# nothing if today's reminder already went out. Set to false to disable.
CRON_CATCH_UP_ON_BOOT=true

# Web Push (real push notifications, delivered even when no tab is open).
# Generate a keypair with:  npx web-push generate-vapid-keys
# Leave both blank to run without push — the in-app bell still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# SendGrid (transactional email: password reset, email verification,
# calendar-reminder invites). Free tier: 100 emails/day, no domain needed.
#
# THREE things must all be true or mail either fails outright or silently
# never reaches the inbox:
#
#   1. The API key must have the "Mail Send" scope. Settings > API Keys.
#      A Restricted Access key created without it authenticates fine and
#      then rejects every send. Full Access keys always have it.
#   2. EMAIL_FROM must EXACTLY match a verified sender. Settings > Sender
#      Authentication > Single Sender Verification > add an address you own
#      and click the confirmation link SendGrid emails you (no DNS needed).
#   3. EMAIL_FROM must be on a domain YOU OWN. A free-provider address
#      (gmail.com, yahoo.com, outlook.com, icloud.com...) will be accepted
#      by SendGrid with a 202 and then junked or refused by the recipient's
#      provider, because those domains' DMARC records don't authorise
#      SendGrid and you can't change them. This looks exactly like "not
#      sending" but is really "not delivering". Single Sender Verification
#      does NOT fix it — it proves you own the inbox, not the domain.
#      Real fix: Settings > Sender Authentication > Authenticate Your Domain,
#      add the CNAMEs to your DNS, then use noreply@yourdomain.com.
#
# This file is the one the backend reads — the root .env is Vite-only.
# Stuck? Run:  npm run email-doctor          (add -- you@gmail.com to send)
#
# Leave SENDGRID_API_KEY blank in dev — emails just get logged to the
# console instead of sent, so forgot-password/verify links still work,
# just from the log.
SENDGRID_API_KEY=
EMAIL_FROM=Kall Konnect <you@example.com>

# Auth cookies.
#
# COOKIE_SECURE: leave false for local/LAN http dev; set true once you're on
# HTTPS in production (browsers drop Secure cookies over plain http).
#
# COOKIE_DOMAIN: only set behind a real domain you own, e.g. .wyntek.tech.
# Leave unset for localhost/LAN and for platform subdomains.
#
# COOKIE_SAMESITE: normally leave blank — it's derived automatically:
#   COOKIE_DOMAIN set          -> lax  (frontend + API share a parent domain)
#   HTTPS, no COOKIE_DOMAIN    -> none (split hosting, e.g. Vercel + Render;
#                                       Lax cookies are NOT sent cross-site,
#                                       so login would silently do nothing)
#   plain http dev             -> lax
# SameSite=None forces Secure on, because browsers reject the pairing
# otherwise. Lax is meaningfully safer, so prefer putting the frontend and
# API on subdomains of one domain and setting COOKIE_DOMAIN.
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=

# Number of reverse proxies in front of this server. Auto-detects to 1 on
# Render and whenever NODE_ENV=production; 0/false locally. This MUST be
# right behind a load balancer, or express sees the proxy's IP for every
# request and all users share one rate-limit bucket — the forgot-password
# limit is 5/hour, so the 6th reset request from ANY user would 429 and
# send no email.
TRUST_PROXY=

# ── Deploying (Vercel frontend + Render backend) ────────────────────────
# Set these in each platform's dashboard, NOT in a committed .env file.
#
# Render (backend):  NODE_ENV=production, DATABASE_URL, JWT_SECRET,
#   SENDGRID_API_KEY, EMAIL_FROM, COOKIE_SECURE=true,
#   APP_URL=https://your-frontend.vercel.app,
#   CORS_ORIGIN=https://your-frontend.vercel.app
#   Build: npm install   Start: npm start   (run `npm run migrate` once)
#
# Vercel (frontend):  VITE_API_URL=https://your-api.onrender.com
#                     VITE_WS_URL=wss://your-api.onrender.com   <- wss, not ws
#
# APP_URL is what gets baked into password-reset links, so it must be the
# public frontend URL — not a LAN IP and not the backend's own address.
