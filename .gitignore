# Dependencies and build output
node_modules/
dist/
dist-ssr/
*.local

# Secrets. Only the *.env.example files belong in the repo. If a real .env
# was ever committed, deleting it is not enough: rotate every key in it.
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Android signing material for the TWA build (twa/README.md)
*.keystore
*.jks
twa/*.apk
twa/*.aab

# Logs and editor/OS clutter
logs/
*.log
npm-debug.log*
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
